# Environment variables - never upload to GitHub
.env

# Python cache files - automatically generated, don't need to track
__pycache__/
*.pyc

# VS Code settings - personal preferences, not project files
.vscode/

# Data files - raw and cleaned data files stay local only
*.csv
*.xlsx
*.xls
.~lock.*


# Dataset folders - contain scripts already tracked individually via /scripts,
# these local copies exist only for the raw/cleaned data files they hold
funding_archive_2000_2018/
funding_legacy_2020_2023/
funding_live_2023_current/